{
  "name": "jarvis-cyber",
  "version": "4.0.0",
  "description": "Jarvis Cyber — Autonomous AI Cybersecurity Agent with MCP Server, Auto-Learning, Dynamic Tool Bridge, 150+ Security Tools",
  "main": "cli.js",
  "bin": {
    "jarvis": "./cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "cli.js",
    "src/",
    "public/",
    "skills/",
    "tests/",
    "install-service.sh",
    "AGENT.md",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "start": "node cli.js",
    "dev": "node cli.js --verbose",
    "telegram": "node cli.js --telegram",
    "daemon": "node cli.js --daemon",
    "learn": "node cli.js --learn",
    "mcp": "node cli.js --mcp",
    "mcp:sse": "node cli.js --mcp --port 8888",
    "web": "node cli.js --web",
    "web:dev": "node cli.js --web --port 3000",
    "install-service": "chmod +x install-service.sh && ./install-service.sh",
    "test": "node tests/test-all.js"
  },
  "keywords": [
    "jarvis",
    "cybersecurity",
    "agent",
    "ai",
    "telegram",
    "pentest",
    "recon",
    "osint",
    "exploit",
    "autonomous",
    "security",
    "hacking",
    "scanner",
    "vulnerability",
    "nuclei",
    "projectdiscovery",
    "fofa",
    "auto-learning",
    "threat-intelligence"
  ],
  "author": "Jarvis Team",
  "license": "MIT",
  "homepage": "https://github.com/ABINAYAN-HUB/Jarvis-Cyber",
  "repository": {
    "type": "git",
    "url": "https://github.com/ABINAYAN-HUB/Jarvis-Cyber.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "arangojs": "^10.3.1",
    "axios": "^1.14.0",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.3.0",
    "cheerio": "^1.2.0",
    "diff": "^5.2.0",
    "dotenv": "^17.3.1",
    "duck-duck-scrape": "^2.2.7",
    "express": "^5.2.1",
    "glob": "^10.3.10",
    "marked": "^12.0.0",
    "marked-terminal": "^7.0.0",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.67.0",
    "ora": "^8.0.1",
    "puppeteer": "^24.9.0",
    "socket.io": "^4.8.3",
    "whois-json": "^2.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
