# ═══════════════════════════════════════════════════════════════
# Jarvis Cyber — Environment Configuration
# Copy this to .env and fill in your API keys
# ═══════════════════════════════════════════════════════════════

# ═══ NVIDIA NIM API (REQUIRED) ═══
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.1

# ═══ TELEGRAM BOT (REQUIRED for --telegram mode) ═══
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_IDS=your-telegram-user-id

# ═══ SHODAN API (Recommended) ═══
SHODAN_API_KEY=your-shodan-api-key

# ═══ TAVILY SEARCH PRO (Recommended) ═══
TAVILY_API_KEY=your-tavily-api-key

# ═══ VIRUSTOTAL API ═══
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# ═══ FOFA API ═══
FOFA_EMAIL=your-fofa-email
FOFA_API_KEY=your-fofa-api-key

# ═══ PROJECTDISCOVERY CLOUD PLATFORM ═══
PDCP_API_KEY=your-pdcp-api-key

# ═══ OUTPUT DIRECTORY ═══
OUTPUT_DIR=./jarvis-output

# ═══ HEARTBEAT (Daemon Mode) ═══
HEARTBEAT_CRON=*/30 * * * *

# ═══ AUTO-LEARNING (24/7 Continuous) ═══
LEARNING_CRON=*/30 * * * *
LEARNING_ENABLED=true
